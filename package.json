{
  "name": "documentary-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @studio/web",
    "dev:worker": "npm run dev -w @studio/worker",
    "build": "npm run build -w @studio/web",
    "start:worker": "npm run start -w @studio/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose stop mongo"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  }
}
